# pico-dgx-ds4 — cp .env.example .env (start.sh and stop.sh load it; .env is
# gitignored). Every line is optional and this file is all there is: anything not
# here is a default in start.sh.
#
# The API: where it listens and what it answers to.
PORT=8888
ADDR=127.0.0.1
MODEL=deepseek-v4.1-flash
#
# The weights. Pinned to one repository and revision inside the tool; found in
# ~/DeepSeek-V4.1-Flash[-1017], /data/models/* and the Hub cache, and streamed
# from the Hub only when none of those opens. IS_LOCAL=1 forbids that: the run
# fails instead of downloading.
# IS_LOCAL=1
#
# 1: serve without a bearer key (loopback or a trusted network only — with
# ADDR=0.0.0.0 that is an open endpoint).
# NO_AUTH=1
#
# The ring as cabled. Leave it unset for the switchless ring this repo's fleet
# uses; 2 when every rank reaches every other in one hop (one switch): each rank
# then writes its contribution to the rank opposite it instead of relaying it
# through a neighbour (+1-2 %, same bits). Only valid at four ranks.
# RING_DIRECT=2
#
# Vision is on: the encoder's slice of the checkpoint is kept (~2.3 GB) and image
# parts are accepted. The encoder itself runs from a torch/PIL image, built from
# tools/vision/Dockerfile on first use; VISION_IMAGE names another one.
# VISION=0
# VISION_IMAGE=<image with torch + PIL + safetensors>
#
# The engine's own arguments; the defaults in start.sh are the production ones.
# ENGINE_ARGS="--max-ctx 262144"
#
# The rank list is the fleet file (ds41f-4xgx10-switchless/fleet/homelab.conf) and
# it is the rank count — there is no TP. WORKERS only writes that file when it is
# missing: rank 0 is this box, each target is one more rank.
# WORKERS="olyno@10.0.0.4 olyno@10.0.0.3 olyno@10.0.0.2"
#
# Only for a gated or private checkpoint.
# HF_TOKEN=hf_...
#
# Working on the image instead of using it.
# IMAGE=pico-dgx-ds4:latest
# SKIP_BUILD=1
# DRY_RUN=1
