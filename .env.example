# pico-dgx-ds4 — cp .env.example .env (start.sh and stop.sh load it; .env is
# gitignored). Every line is optional, and this file is the complete list of what
# exists: anything not here is a default in start.sh.
#
# Where the API listens and what it calls itself. The weights are pinned in the
# tool (repository + revision) and found automatically; the name below is what
# the OpenAI API answers to.
DSGB10_PORT=18893
DSGB10_ADDR=127.0.0.1
# DSGB10_MODEL=deepseek-v4.1-flash
#
# The rank list is the fleet file (FLEET), and it is what the rank count comes
# from — there is no TP to set. WORKERS only writes that file when it does not
# exist yet: rank 0 is this box, each target is one more rank.
# WORKERS="olyno@10.0.0.4 olyno@10.0.0.3 olyno@10.0.0.2"
# FLEET=./ds41f-4xgx10-switchless/fleet/homelab.conf   # only if it lives elsewhere
#
# 1: serve without a bearer key (loopback or a trusted network only — with
# DSGB10_ADDR=0.0.0.0 that is an open endpoint).
# DSGB10_NO_AUTH=1
#
# Direct ring: 2 when every rank reaches every other in one hop (one switch).
# DSGB10_RING_DIRECT=2
#
# Engine arguments; the defaults in start.sh are the production ones.
# DSGB10_ENGINE_ARGS="--max-ctx 262144"
#
# Images: VISION=1 keeps the encoder's slice of the checkpoint (~2.3 GB) and
# points dsfront at it; VISION_IMAGE is a torch/PIL/safetensors image that runs
# the encoder from that bundle.
# VISION=1
# VISION_IMAGE=<image with torch + PIL + safetensors>
# IMAGE=pico-dgx-ds4:latest
#
# Only for a gated or private checkpoint.
# HF_TOKEN=hf_...
#
# Working on the image instead of using it.
# SKIP_BUILD=1
# DRY_RUN=1
